rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdminUser() {
      return request.auth != null &&
        request.auth.token.email == "kakakkuganteng@gmail.com" &&
        request.auth.token.email_verified == true;
    }

    function isValidPortalConfig(data) {
      return data.keys().hasAll(['branding', 'competitions', 'schedules']) &&
        data.branding is map &&
        data.competitions is list &&
        data.schedules is list;
    }

    function isValidRegistration(data) {
      return data.keys().hasAll(['id', 'competitionId', 'competitionName', 'satker', 'namaTimAtauPeserta']) &&
        data.id is string && data.id.size() > 0 && data.id.size() <= 120 &&
        data.competitionId is string && data.competitionId.size() > 0 && data.competitionId.size() <= 120 &&
        data.competitionName is string && data.competitionName.size() > 0 && data.competitionName.size() <= 250 &&
        data.satker is string && data.satker.size() > 0 && data.satker.size() <= 200 &&
        data.namaTimAtauPeserta is string && data.namaTimAtauPeserta.size() > 0 && data.namaTimAtauPeserta.size() <= 250;
    }

    function isValidCoupon(data) {
      return data.keys().hasAll(['id', 'nomorKupon', 'namaPeserta', 'satkerAtauUmum']) &&
        data.id is string && data.id.size() > 0 && data.id.size() <= 120 &&
        data.nomorKupon is string && data.nomorKupon.size() > 0 && data.nomorKupon.size() <= 60 &&
        data.namaPeserta is string && data.namaPeserta.size() > 0 && data.namaPeserta.size() <= 200 &&
        data.satkerAtauUmum is string && data.satkerAtauUmum.size() > 0 && data.satkerAtauUmum.size() <= 200;
    }

    function isValidHarmonyMessage(data) {
      return data.keys().hasAll(['id', 'nama', 'pesan']) &&
        data.id is string && data.id.size() > 0 && data.id.size() <= 120 &&
        data.nama is string && data.nama.size() > 0 && data.nama.size() <= 150 &&
        data.pesan is string && data.pesan.size() > 0 && data.pesan.size() <= 2000;
    }

    function isValidVideo(data) {
      return data.keys().hasAll(['id', 'judul', 'satker']) &&
        data.id is string && data.id.size() > 0 && data.id.size() <= 120 &&
        data.judul is string && data.judul.size() > 0 && data.judul.size() <= 300 &&
        data.satker is string && data.satker.size() > 0 && data.satker.size() <= 200;
    }

    function isValidSatkerBanner(data) {
      return data.keys().hasAll(['id', 'judul', 'satker', 'kategori', 'imageUrl']) &&
        data.id is string && data.id.size() > 0 && data.id.size() <= 120 &&
        data.judul is string && data.judul.size() > 0 && data.judul.size() <= 300 &&
        data.satker is string && data.satker.size() > 0 && data.satker.size() <= 200 &&
        data.kategori is string && data.kategori.size() > 0 && data.kategori.size() <= 120 &&
        data.imageUrl is string && data.imageUrl.size() > 0 && data.imageUrl.size() <= 900000;
    }

    function isValidJournal(data) {
      return data.keys().hasAll(['id', 'judul', 'penulis', 'photos']) &&
        data.id is string && data.id.size() > 0 && data.id.size() <= 120 &&
        data.judul is string && data.judul.size() > 0 && data.judul.size() <= 400 &&
        data.penulis is string && data.penulis.size() > 0 && data.penulis.size() <= 200 &&
        data.photos is list && data.photos.size() >= 1 && data.photos.size() <= 4;
    }

    match /portalConfig/{docId} {
      allow read: if true;
      allow create, update: if isValidPortalConfig(request.resource.data) || isAdminUser();
      allow delete: if isAdminUser();
    }

    match /registrations/{regId} {
      allow read: if true;
      allow create, update: if isValidRegistration(request.resource.data) || isAdminUser();
      allow delete: if true;
    }

    match /coupons/{couponId} {
      allow read: if true;
      allow create, update: if isValidCoupon(request.resource.data) || isAdminUser();
      allow delete: if true;
    }

    match /messages/{msgId} {
      allow read: if true;
      allow create, update: if isValidHarmonyMessage(request.resource.data) || isAdminUser();
      allow delete: if true;
    }

    match /videos/{videoId} {
      allow read: if true;
      allow create, update: if isValidVideo(request.resource.data) || isAdminUser();
      allow delete: if true;
    }

    match /satkerBanners/{bannerId} {
      allow read: if true;
      allow create, update: if isValidSatkerBanner(request.resource.data) || isAdminUser();
      allow delete: if true;
    }

    match /journals/{journalId} {
      allow read: if true;
      allow create, update: if isValidJournal(request.resource.data) || isAdminUser();
      allow delete: if true;
    }
  }
}
